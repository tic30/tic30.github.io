{
    "name": "tic30.github.io",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "deploy": "npm run build && gh-pages -d build",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix && prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
        "tsc": "tsc -b",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@mui/system": "^9.2.0",
        "markdown-to-jsx": "^9.10.1",
        "motion": "^12.43.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "react-router-hash-link": "^2.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-router-hash-link": "^2.4.9",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "gh-pages": "^6.3.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
            "prettier --write"
        ]
    }
}
